<%= render "application/shared_errors", object: @category %>
<%= form_with model: @category, class: "card p-4 shadow-sm" do |f| %>
  <div class="mb-3"><%= f.label :name, class: "form-label" %><%= f.text_field :name, class: "form-control" %></div>
  <div class="mb-3"><%= f.label :description, class: "form-label" %><%= f.text_area :description, class: "form-control", rows: 4 %></div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
