<div class="d-flex justify-content-between align-items-center mb-3"><h1>Categories</h1><%= link_to "New Category", new_category_path, class: "btn btn-primary" %></div>
<div class="row g-3"><% @categories.each do |category| %><div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><h5><i class="bi bi-folder-fill text-warning"></i> <%= link_to category.name, category, class: "text-decoration-none" %></h5><p><%= category.description %></p><span class="badge text-bg-secondary"><%= category.todos.count %> ToDos</span></div></div></div><% end %></div>
