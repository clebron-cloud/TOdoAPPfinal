<div class="card shadow-sm todo-card <%= 'priority-card' if @todo.priority %> <%= 'completed-card' if @todo.completed %>"><div class="card-body"><h1><%= @todo.title %></h1><p><strong>Category:</strong> <%= link_to @todo.category.name, @todo.category %></p><p><strong>Priority:</strong> <%= @todo.priority ? "Yes" : "No" %></p><p><strong>Completed:</strong> <%= @todo.completed ? "Yes" : "No" %></p><%= link_to "Edit", edit_todo_path(@todo), class: "btn btn-outline-primary" %> <%= button_to "Delete", @todo, method: :delete, class: "btn btn-outline-danger d-inline-block", data: { turbo_confirm: "Delete this todo?" } %></div></div>
