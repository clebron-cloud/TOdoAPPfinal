<div class="card todo-card shadow-sm mb-3 <%= 'priority-card' if todo.priority %> <%= 'completed-card' if todo.completed %>">
  <div class="card-body d-flex justify-content-between align-items-start">
    <div>
      <h5><%= link_to todo.title, todo, class: "text-decoration-none" %></h5>
      <p class="mb-1"><i class="bi bi-folder"></i> <%= todo.category.name %></p>
      <% if todo.priority %><span class="badge text-bg-danger"><i class="bi bi-exclamation-triangle"></i> Priority</span><% end %>
      <% if todo.completed %><span class="badge text-bg-success"><i class="bi bi-check-circle"></i> Completed</span><% end %>
    </div>
    <div><%= link_to "Edit", edit_todo_path(todo), class: "btn btn-sm btn-outline-primary" %> <%= button_to "Delete", todo, method: :delete, class: "btn btn-sm btn-outline-danger d-inline-block", data: { turbo_confirm: "Delete this todo?" } %></div>
  </div>
</div>
