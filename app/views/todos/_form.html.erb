<%= render "application/shared_errors", object: @todo %>
<% if current_user.categories.empty? %><div class="alert alert-warning">Create a category before making a ToDo.</div><% end %>
<%= form_with model: @todo, class: "card p-4 shadow-sm" do |f| %>
  <div class="mb-3"><%= f.label :title, class: "form-label" %><%= f.text_field :title, class: "form-control" %></div>
  <div class="mb-3"><%= f.label :category_id, "Category", class: "form-label" %><%= f.collection_select :category_id, current_user.categories, :id, :name, {}, class: "form-select" %></div>
  <div class="form-check mb-2"><%= f.check_box :priority, class: "form-check-input" %><%= f.label :priority, class: "form-check-label" %></div>
  <div class="form-check mb-3"><%= f.check_box :completed, class: "form-check-input" %><%= f.label :completed, class: "form-check-label" %></div>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
