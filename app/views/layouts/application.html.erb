<!DOCTYPE html>
<html>
  <head>
    <title>Final ToDo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container">
        <%= link_to "Final ToDo", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
          <ul class="navbar-nav me-auto">
            <% if logged_in? %>
              <li class="nav-item"><%= link_to "ToDos", todos_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Categories", categories_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Completed ToDos", completed_todos_path, class: "nav-link" %></li>
            <% end %>
          </ul>
          <ul class="navbar-nav ms-auto">
            <% if logged_in? %>
              <li class="nav-item"><span class="navbar-text me-3">Hi, <%= current_user.first_name %></span></li>
              <li class="nav-item"><%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline-light btn-sm" %></li>
            <% else %>
              <li class="nav-item"><%= link_to "Login", login_path, class: "btn btn-outline-light btn-sm me-2" %></li>
              <li class="nav-item"><%= link_to "Sign Up", signup_path, class: "btn btn-warning btn-sm" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    <main class="container py-4">
      <% flash.each do |type, msg| %>
        <div class="alert <%= type == 'alert' ? 'alert-danger' : 'alert-success' %>"><%= msg %></div>
      <% end %>
      <%= yield %>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
